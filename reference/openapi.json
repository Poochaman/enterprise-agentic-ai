  },
  "components": {
    "securitySchemes": {
      "demoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Public fixture tokens: demo-acme, demo-beta, demo-acme-approver, demo-beta-approver."
      }
    },
    "schemas": {
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "message"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Non-blank after trimming. Untrusted enquiry text, never authority."
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Workflow": {
        "type": "object",
        "required": [
          "requestId",
          "tenant",
          "agent",
          "state",
          "action",
          "result",
          "attempts",
          "approvedBy",
          "trace"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "enum": [
              "sales",
              "support",
              "review"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "awaiting_approval",
              "approved",
              "executing",
              "retry_pending",
              "completed",
              "rejected",
              "cancelled",
              "needs_review"
            ]
          },
          "action": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event",
                "detail"
              ],
              "properties": {
                "event": {
                  "type": "string"
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
