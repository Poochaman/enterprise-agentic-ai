  "components": {
    "securitySchemes": {
      "demoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Public fixture tokens: demo-acme, demo-beta, demo-acme-approver, demo-beta-approver."
      }
    },
    "schemas": {
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "message"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Untrusted enquiry text, never authority; must contain non-whitespace characters."
          },
          "leadCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "description": "Synthetic CRM record count; sales only. Execution separately checks the approved limit."
          }
        }
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "actionDigest"
            ],
            "properties": {
              "decision": {
                "const": "approve"
              },
              "actionDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ttlSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 900,
                "default": 300
              },
              "maxActions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3,
                "default": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "const": "reject"
              }
            }
          }
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Workflow": {
        "type": "object",
        "required": [
          "requestId",
          "tenant",
          "agent",
          "state",
          "action",
          "result",
          "attempts",
          "approvedBy",
          "trace",
          "revision",
          "authority"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "tenant": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "enum": [
              "sales",
              "support",
              "review"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "awaiting_approval",
              "approved",
              "executing",
              "retry_pending",
              "completed",
              "rejected",
              "cancelled",
              "needs_review",
              "expired",
              "revoked",
              "budget_exceeded"
            ]
          },
          "action": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event",
                "detail"
              ],
              "properties": {
                "event": {
                  "type": "string"
                },
                "detail": {
                  "type": "object"
                }
              }
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "authority": {
            "type": "object",
            "required": [
              "actionDigest",
              "approvedDigest",
              "expiresAt",
              "maxActions",
              "revoked",
              "status"
            ],
            "properties": {
              "actionDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "approvedDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expiresAt": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Unix epoch seconds; expired when server time is greater than or equal to this value."
              },
              "maxActions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 3
              },
              "revoked": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_granted",
                  "valid",
                  "expired",
                  "revoked"
                ]
              }
            }
          }
        }
      },
      "Revision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "revision"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Untrusted enquiry text, never authority; must contain non-whitespace characters."
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "leadCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "description": "Synthetic CRM record count; sales only. Execution separately checks the approved limit."
          }
        }
      }
    }
  }
}
