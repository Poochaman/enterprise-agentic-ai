  "sources": [
    {
      "id": "PLAN-01",
      "title": "Synthetic delivery baseline",
      "text": "Illustrative infrastructure programme. Durations are working days, Monday to Friday; holidays and resource constraints are excluded. A finish date is the boundary at which a successor may start. Finish-to-start dependencies have no lag. These are teaching assumptions, not engineering estimates for a real facility."
    },
    {
      "id": "GOV-01",
      "title": "Change ownership",
      "text": "Workstream owners review impacts. The programme director approves baseline changes. Analysis does not change the baseline or issue supplier instructions."
    },
    {
      "id": "SUP-01",
      "title": "Illustrative supplier issue",
      "text": "A supplier scenario assumes power equipment takes 15 additional working days. Confirm actual delivery dates and dependencies before a real programme decision."
    }
  ]
